egory" class="w-full mt-1 p-2 border rounded-xl text-slate-800 focus:outline-none focus:border-primary bg-white"> <option value="atta">Aata & Chawal</option> <option value="oil">Ghee & Cooking Oil</option> <option value="daal">Tamam Daalein</option> <option value="chai">Chai & Masala Jaat</option> <option value="dairy">Doodh, Dahi & Bakery</option> <option value="cleaning">Surf, Sabun & Cleaner</option> <option value="snacks">Snacks & Biscuits</option> </select> </div> </div> <div class="grid grid-cols-2 gap-2"> <div> <label class="font-bold text-slate-700">Naya Rate (Rs.) *</label> <input type="number" id="itemInputPrice" placeholder="520" class="w-full mt-1 p-2 border rounded-xl font-bold text-primary focus:outline-none focus:border-primary"> </div> <div> <label class="font-bold text-slate-700">Purana Rate (Rs.)</label> <input type="number" id="itemInputOldPrice" placeholder="550" class="w-full mt-1 p-2 border rounded-xl text-slate-400 focus:outline-none focus:border-primary"> </div> </div> <div> <label class="font-bold text-slate-700">Specifications / Tafseel (Specs)</label> <input type="text" id="itemInputSpecs" placeholder="e.g. A-grade Quality, Original Company Packing" class="w-full mt-1 p-2 border rounded-xl text-slate-600 focus:outline-none focus:border-primary"> </div> <div class="grid grid-cols-2 gap-2"> <div> <label class="font-bold text-slate-700">Badge / Tag (Optional)</label> <input type="text" id="itemInputBadge" placeholder="e.g. Fresh Grind, Super Deal" class="w-full mt-1 p-2 border rounded-xl text-slate-700 focus:outline-none focus:border-primary"> </div> <div> <label class="font-bold text-slate-700">Icon Select Karein</label> <select id="itemInputIcon" class="w-full mt-1 p-2 border rounded-xl text-slate-700 focus:outline-none focus:border-primary bg-white"> <option value="fa-wheat-awn">Gandum / Wheat</option> <option value="fa-bowl-rice">Chawal / Rice</option> <option value="fa-bottle-droplet">Oil / Tail</option> <option value="fa-cube">Ghee / Dabba</option> <option value="fa-seedling">Daal / Pulse</option> <option value="fa-mug-hot">Chai / Tea</option> <option value="fa-mortar-pestle">Masala / Namak</option> <option value="fa-cookie-bite">Biscuit / Snack</option> <option value="fa-soap">Surf / Soap</option> <option value="fa-box">General Box</option> </select> </div> </div> <!-- Available vs Sold Out Switch --> <div class="p-2.5 bg-slate-50 border rounded-xl flex items-center justify-between"> <div> <div class="font-bold text-slate-800">Stock Status</div> <div class="text-[10px] text-slate-400">Available ya Khatam (Sold Out)</div> </div> <label class="relative inline-flex items-center cursor-pointer"> <input type="checkbox" id="itemInputStock" class="sr-only peer" checked> <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div> </label> </div> <div class="flex gap-2 pt-2 border-t border-slate-100"> <button type="button" onclick="closeItemModal()" class="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-600 font-bold hover:bg-slate-200">Cancel</button> <button type="button" onclick="saveItem()" class="flex-1 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold shadow">Save Item</button> </div> </div> </div> </div> </div> <!-- JAVASCRIPT ENGINE (LOCALSTORAGE ENABLED) --> <script> const defaultShop = { name: 'Ehtisham General Store', address: 'Model Town, Lahore', whatsapp: '03001234567', iconLetter: 'E', deliveryTime: '20-30 Mins Delivery' }; let shopProfile = JSON.parse(localStorage.getItem('egs_shop_profile')) || defaultShop; const defaultProducts = [ { id: 1, name: 'Chakki Atta No. 1 Super', category: 'atta', weight: '10kg Bag', price: 1420, oldPrice: 1500, specs: '100% Desi Gandum, Chokar Mila, Fresh Grind', icon: 'fa-wheat-awn', iconColor: 'text-amber-600', badge: 'Daily Fresh', inStock: true }, { id: 2, name: 'Guard Super Basmati Rice', category: 'atta', weight: '1kg Clean Pack', price: 360, oldPrice: 400, specs: 'Purana Chawal, Khushboodar Super Kernel', icon: 'fa-bowl-rice', iconColor: 'text-emerald-600', badge: 'Bumper Deal', inStock: true }, { id: 3, name: 'Dalda Cooking Oil Pouch', category: 'oil', weight: '1 Litre Pouch', price: 520, oldPrice: 550, specs: 'Vitamin A & D se bharpoor, Original Seal', icon: 'fa-bottle-droplet', iconColor: 'text-yellow-600', badge: 'Original', inStock: true }, { id: 4, name: 'Sufi Banaspati Ghee', category: 'oil', weight: '1kg Poly Pouch', price: 510, oldPrice: 530, specs: 'Khaalis zaiqa aur lazeez khanon k liye', icon: 'fa-cube', iconColor: 'text-amber-500', badge: 'Special', inStock: true }, { id: 5, name: 'Daal Chana (Safaid Grade-A)', category: 'daal', weight: '1kg Saaf Shuda', price: 280, oldPrice: 310, specs: 'Baree dany wali saaf suthri desi daal', icon: 'fa-seedling', iconColor: 'text-orange-500', badge: 'Desi', inStock: true }, { id: 6, name: 'Daal Moong Dhuli (Washed)', category: 'daal', weight: '1kg Pack', price: 320, oldPrice: 350, specs: 'Zard rangat, jaldi galne wali top quality', icon: 'fa-seedling', iconColor: 'text-green-600', badge: 'Top Grade', inStock: true }, { id: 7, name: 'Tapal Danedar Chai', category: 'chai', weight: '430g Family Pack', price: 680, oldPrice: 720, specs: 'Mazboot rang aur karkht zaiqa', icon: 'fa-mug-hot', iconColor: 'text-red-600', badge: 'Family Pack', inStock: true }, { id: 8, name: 'National Iodized Salt', category: 'chai', weight: '800g Pouch', price: 60, oldPrice: 70, specs: 'Iodine mila safe aur refined namak', icon: 'fa-mortar-pestle', iconColor: 'text-blue-500', badge: 'Refined', inStock: false } ]; let products = JSON.parse(localStorage.getItem('egs_products_list')) || defaultProducts; const categoryNames = { 'all': 'Sab Items', 'atta': 'Aata & Chawal', 'oil': 'Ghee & Oil', 'daal': 'Tamam Daalein', 'chai': 'Chai & Masala', 'dairy': 'Dairy & Bakery', 'cleaning': 'Cleaning & Soap', 'snacks': 'Snacks & Biscuits' }; let cart = {}; let currentFilter = 'all'; function init() { renderShopProfile(); renderCategoryPills(); renderProducts(); renderCategoriesView(); updateCartDisplay(); } function saveState() { localStorage.setItem('egs_shop_profile', JSON.stringify(shopProfile)); localStorage.setItem('egs_products_list', JSON.stringify(products)); } function renderShopProfile() { document.getElementById('headerShopTitle').innerText = shopProfile.name; document.getElementById('headerShopAddress').innerHTML = `<i class="fa-solid fa-location-dot text-[10px] text-red-500"></i> ${shopProfile.address}`; document.getElementById('shopAddressText').innerText = shopProfile.address; document.getElementById('shopInitialLetter').innerText = shopProfile.iconLetter || shopProfile.name.charAt(0); document.getElementById('headerShopPhone').innerText = shopProfile.whatsapp; document.getElementById('headerDeliveryTime').innerText = shopProfile.deliveryTime; document.getElementById('khataStoreHeading').innerText = `${shopProfile.name} Khata Book`; document.getElementById('storeStatsOverview').innerText = `${shopProfile.name}`; } function renderCategoryPills() { const container = document.getElementById('categoryPillContainer'); const cats = ['all', 'atta', 'oil', 'daal', 'chai', 'dairy', 'cleaning', 'snacks']; container.innerHTML = cats.map(c => ` <button onclick="filterCategory('${c}')" class="cat-pill px-3 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition ${currentFilter === c ? 'bg-primary text-white shadow-sm' : 'bg-white text-slate-600 border border-slate-200'}"> ${categoryNames[c] || c} </button> `).join(''); } function renderProducts() { const grid = document.getElementById('productGrid'); const searchInput = document.getElementById('searchInput'); const searchVal = searchInput ? searchInput.value.toLowerCase().trim() : ''; const filtered = products.filter(p => { const matchesCat = (currentFilter === 'all') || (p.category === currentFilter); const matchesSearch = p.name.toLowerCase().includes(searchVal) || p.weight.toLowerCase().includes(searchVal) || (p.specs && p.specs.toLowerCase().includes(searchVal)); return matchesCat && matchesSearch; }); const badgeCount = document.getElementById('productBadgeCount'); if (badgeCount) badgeCount.innerText = `${filtered.length} items`; document.getElementById('statTotalItems').innerText = products.length; document.getElementById('statInStock').innerText = products.filter(p => p.inStock).length; document.getElementById('statSoldOut').innerText = products.filter(p => !p.inStock).length; if (filtered.length === 0) { grid.innerHTML = ` <div class="col-span-2 text-center py-10 bg-white rounded-2xl border border-dashed border-slate-200 p-4"> <i class="fa-solid fa-magnifying-glass text-3xl text-slate-300 mb-2"></i> <p class="text-xs font-bold text-slate-600">Koi item nahi mila</p> <p class="text-[11px] text-slate-400 mt-1">Naya item foran shamil karein:</p> <button onclick="openAddItemModal()" class="mt-3 px-3 py-1.5 bg-primary text-white text-xs font-bold rounded-xl shadow-sm"> + Naya Item Shamil Karein </button> </div> `; return; } grid.innerHTML = filtered.map(p => { const qty = cart[p.id] || 0; return ` <div class="bg-white rounded-2xl p-3 border ${p.inStock ? 'border-slate-100 hover:border-emerald-300' : 'border-red-100 bg-slate-50/50'} shadow-sm flex flex-col justify-between relative group transition"> <div class="absolute top-2 right-2 flex gap-1 z-10"> <button onclick="openEditItemModal(${p.id})" class="w-6 h-6 rounded-lg bg-slate-100 hover:bg-amber-100 text-slate-600 hover:text-amber-700 flex items-center justify-center text-[10px] transition shadow-xs" title="Item / Rate Edit"> <i class="fa-solid fa-pen"></i> </button> <button onclick="toggleItemStock(${p.id})" class="w-6 h-6 rounded-lg ${p.inStock ? 'bg-slate-100 hover:bg-red-100 text-slate-600 hover:text-red-600' : 'bg-red-500 text-white'} flex items-center justify-center text-[9px] font-bold transition shadow-xs" title="Toggle Stock Status"> ${p.inStock ? '<i class="fa-solid fa-box"></i>' : '<i class="fa-solid fa-ban"></i>'} </button> </div> <div> <div class="w-full h-24 ${p.inStock ? 'bg-slate-50' : 'bg-red-50/50'} rounded-xl flex items-center justify-center relative mb-2"> ${p.badge ? ` <span class="absolute top-1.5 left-1.5 bg-white/95 text-emerald-800 font-extrabold text-[9px] px-1.5 py-0.5 rounded-md shadow-xs border border-emerald-100"> ${p.badge} </span> ` : ''} ${!p.inStock ? ` <span class="absolute bottom-1.5 right-1.5 bg-red-600 text-white font-extrabold text-[9px] px-2 py-0.5 rounded shadow"> SOLD OUT </span> ` : ''} <i class="fa-solid ${p.icon || 'fa-box'} text-3xl ${p.iconColor || 'text-primary'} ${!p.inStock ? 'opacity-40' : ''}"></i> </div> <div class="flex items-center justify-between text-[10px] text-slate-400 font-semibold mb-0.5"> <span>${p.weight}</span> <span class="capitalize text-[9px] bg-slate-100 px-1 py-0.5 rounded">${p.category}</span> </div> <h3 class="text-xs font-bold text-slate-800 leading-snug line-clamp-2">${p.name}</h3> <p class="text-[10px] text-slate-500 line-clamp-1 mt-1 font-normal bg-slate-50 px-1.5 py-0.5 rounded"> <i class="fa-solid fa-circle-info text-[9px] text-slate-400"></i> ${p.specs || 'Original Quality Pack'} </p> </div> <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between"> <div> <div class="text-xs font-black text-slate-900">Rs. ${p.price}</div> ${p.oldPrice ? `<div class="text-[10px] text-slate-400 line-through">Rs. ${p.oldPrice}</div>` : ''} </div> ${p.inStock ? ( qty > 0 ? ` <div class="flex items-center gap-1.5 bg-emerald-50 border border-primary text-primary px-1.5 py-1 rounded-xl"> <button onclick="updateQty(${p.id}, -1)" class="w-5 h-5 flex items-center justify-center font-bold text-xs hover:bg-emerald-200 rounded">-</button> <span class="text-xs font-bold px-0.5">${